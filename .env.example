## Local development only: copy to `.env.local`.
## Vite inlines VITE_* values into `npm run build` output. Never publish that build;
## `npm run package` ignores these values and refuses to zip anything that looks like a key.

# Dev server port offset: start from (3000 + offset) when 3000 is busy.
PORT_OFFSET=0

# Prefill the settings page (OpenAI-compatible endpoint).
# VITE_OPENAI_BASE_URL=https://api.deepseek.com/v1
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=deepseek-chat
# VITE_OPENAI_CHEAP_MODEL=
# VITE_OPENAI_EMBEDDING_MODEL=
# VITE_DEVELOPER_MODE=1

# `npm run eval` reads OPENAI_* first, then falls back to the VITE_* values above.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

## Copy to `.env.local` (recommended) and fill in your own keys.
## NOTE: Vite will inline `VITE_*` values into the built extension bundle.
## Do NOT publish builds that contain your private keys.

# Dev server port offset: start from (3000 + offset). Useful when 3000 is occupied.
PORT_OFFSET=0

## Minimal BYOK (recommended)
## If you set either of the following, the extension will auto switch to OpenAI-compatible provider.
# VITE_OPENAI_BASE_URL=https://api.qnaigc.com/v1
# VITE_OPENAI_API_KEY=...

## Advanced (optional)
# VITE_LLM_PROVIDER=openai
# VITE_OPENAI_MODEL=gpt-5.2
# VITE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

## Gemini (optional)
# VITE_LLM_PROVIDER=gemini
# VITE_GEMINI_API_KEY=...

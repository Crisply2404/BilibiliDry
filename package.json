    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "playwright-core": "^1.57.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
